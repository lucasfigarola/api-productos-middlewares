# Puerto de la API
PORT=3000

# Dialecto de base de datos soportado por la version instalada de Sequelize.
# Ejemplos habituales: sqlite, mariadb, mysql, postgres, mssql.
# Usa un dialecto soportado por la version de Sequelize del proyecto.
DB_DIALECT=mysql

# SQLite
# Se utiliza solamente cuando DB_DIALECT=sqlite.
DB_STORAGE=./src/data/tienda.db

# Bases de datos cliente/servidor
# Para SQLite estos valores no son necesarios.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=tienda
DB_USER=root
DB_PASSWORD=

# true para mostrar las consultas SQL en consola
DB_LOGGING=false
